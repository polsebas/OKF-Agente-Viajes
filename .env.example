# Ruta absoluta o relativa al vault de Obsidian tratado como bundle OKF.
OKF_VAULT_ROOT=fixtures/sample_vault

# Modelo primario (Regla de Oro del JSON: siempre corre con temperature=0.0).
# Proveedores: openai | anthropic | ollama
OKF_PRIMARY_MODEL_PROVIDER=ollama
OKF_PRIMARY_MODEL_ID=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=

# Modelos de fallback, formato "provider:model_id", separados por coma.
# Se prueban en orden si el primario agota sus reintentos (rate limit, outage, etc.).
OKF_FALLBACK_MODELS=anthropic:claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=

# Umbral de similitud coseno para candidatos de sinónimos de tags.
OKF_TAG_SIMILARITY_THRESHOLD=0.82
